<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvHeart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textSize="22sp"
                android:textColor="#5C5470"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SoulSpace"
                android:textSize="16sp"
                android:textColor="#2D2D2D"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/avatar_background"
                android:scaleType="centerCrop"/>
        </RelativeLayout>

        <!-- Hero Image -->
        <!-- Hero Image -->
        <ImageView
            android:id="@+id/ivHero"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/hero_image"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Создайте ваши\nотношения"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:fontFamily="serif"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="10dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавьте человека, с которым\nхотите делиться воспоминаниями"
            android:textSize="14sp"
            android:textColor="#8A8A8A"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="32dp"/>

        <!-- Partner Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ПАРТНЕР"
            android:textSize="11sp"
            android:textColor="#8A8A8A"
            android:letterSpacing="0.1"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp"/>

        <!-- Partner Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="15sp"
                android:textColor="#A0A0A0"
                android:paddingEnd="10dp"/>

            <EditText
                android:id="@+id/etPartner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Username или Email"
                android:textColor="#2D2D2D"
                android:textSize="14sp"
                android:background="@null"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- Date Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="НАЧАЛО ОТНОШЕНИЙ"
            android:textSize="11sp"
            android:textColor="#8A8A8A"
            android:letterSpacing="0.1"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp"/>

        <!-- Date Field -->
        <LinearLayout
            android:id="@+id/layoutDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="15sp"
                android:textColor="#A0A0A0"
                android:paddingEnd="10dp"/>

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="дд.мм.гггг"
                android:textColor="#A0A0A0"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Upload Photo Field -->
        <LinearLayout
            android:id="@+id/layoutUploadPhoto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="15sp"
                android:textColor="#A0A0A0"
                android:paddingEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Загрузить совместное фото"
                android:textColor="#A0A0A0"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSendInvite"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Отправить приглашение"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_dark_background"
            android:stateListAnimator="@null"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>