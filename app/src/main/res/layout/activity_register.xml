<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="56dp"
        android:paddingBottom="40dp"
        android:paddingHorizontal="28dp">

        <!-- Sparkle icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textSize="28sp"
            android:textColor="#5C5470"
            android:layout_marginBottom="20dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to\nSoulSpace"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:fontFamily="serif"
            android:layout_marginBottom="10dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Begin your shared journey today."
            android:textSize="14sp"
            android:textColor="#8A8A8A"
            android:gravity="center"
            android:layout_marginBottom="36dp"/>

        <!-- Email Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textSize="16sp"
                android:textColor="#A0A0A0"
                android:paddingEnd="10dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Email Address"
                android:textColor="#2D2D2D"
                android:textSize="14sp"
                android:background="@null"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- Username Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="15sp"
                android:textColor="#A0A0A0"
                android:paddingEnd="10dp"/>

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Username"
                android:textColor="#2D2D2D"
                android:textSize="14sp"
                android:background="@null"
                android:inputType="textPersonName"
                android:imeOptions="actionNext"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- Password Field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="15sp"
                android:textColor="#A0A0A0"
                android:paddingEnd="10dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Password"
                android:textColor="#2D2D2D"
                android:textSize="14sp"
                android:background="@null"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- Create Account Button -->
        <Button
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CREATE ACCOUNT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#4A4560"
            android:background="@drawable/button_background"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp"/>

        <!-- Divider OR CONTINUE WITH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0DDD6"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  OR CONTINUE WITH  "
                android:textSize="11sp"
                android:textColor="#A0A0A0"
                android:letterSpacing="0.08"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0DDD6"/>
        </LinearLayout>

        <!-- Google Button -->
        <LinearLayout
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/social_button_background"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4285F4"
                android:paddingEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google"
                android:textSize="15sp"
                android:textColor="#2D2D2D"/>
        </LinearLayout>

        <!-- Apple Button -->
        <LinearLayout
            android:id="@+id/btnApple"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/social_button_background"
            android:gravity="center"
            android:layout_marginBottom="28dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Apple"
                android:textSize="15sp"
                android:textColor="#2D2D2D"/>
        </LinearLayout>

        <!-- Sign In link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textSize="13sp"
                android:textColor="#8A8A8A"/>

            <TextView
                android:id="@+id/tvSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in"
                android:textSize="13sp"
                android:textColor="#5C5470"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>