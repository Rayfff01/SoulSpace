<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_together_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_together_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/widget_together_heart"
        android:textColor="#5C5470"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_together_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_together_preview_count"
        android:textColor="#2D2D2D"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
