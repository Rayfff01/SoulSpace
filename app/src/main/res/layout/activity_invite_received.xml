<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5F5F0"
    android:paddingHorizontal="32dp">

    <!-- Avatar -->
    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/ivPartnerAvatar"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/avatar_circle_background"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder"/>

        <!-- Heart badge -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/phone_badge_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="♥"
                android:textSize="14sp"
                android:textColor="#5C5470"/>
        </FrameLayout>
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvInviteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Имя приглашает вас\nсоздать отношения"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:fontFamily="serif"
        android:layout_marginBottom="20dp"/>

    <!-- Date -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 "
            android:textSize="14sp"
            android:textColor="#8A8A8A"/>

        <TextView
            android:id="@+id/tvInviteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Начало: —"
            android:textSize="14sp"
            android:textColor="#6A6A6A"/>
    </LinearLayout>

    <!-- Accept Button -->
    <Button
        android:id="@+id/btnAccept"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="ПРИНЯТЬ"
        android:textSize="13sp"
        android:letterSpacing="0.08"
        android:textColor="#4A4560"
        android:background="@drawable/button_background"
        android:stateListAnimator="@null"
        android:layout_marginBottom="16dp"/>

    <!-- Decline Button -->
    <TextView
        android:id="@+id/tvDecline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ОТКЛОНИТЬ"
        android:textSize="13sp"
        android:letterSpacing="0.08"
        android:textColor="#8A8A8A"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>